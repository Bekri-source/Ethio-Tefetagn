# Dependencies
node_modules/

# Environment secrets — never commit real API keys
.env
.env.local

# OS / editor cruft
.DS_Store
*.log
npm-debug.log*

# Uploaded textbooks are large binary files — usually better hosted outside git
# (see DEPLOYMENT.md). Comment this out if you'd rather commit them directly.
Books/**/*.pdf

# Generated by `npm run ingest` — regenerate anytime from the PDFs in Books/,
# no need to version-control the output.
server/books/*.json
